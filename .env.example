# Copy to .env (repo root). Every value is optional for local development.

# MongoDB. Leave empty to use the embedded mongodb-memory-server (data kept in .data/mongo).
# Local:  mongodb://127.0.0.1:27017/work_tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/work_tracker?retryWrites=true&w=majority
MONGODB_URI=

# Auth — set a long random value in any shared or production environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Claude. Leave empty to run the AI features in offline demo mode (heuristics).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Server
PORT=4100
CORS_ORIGIN=http://localhost:5174
# Set to false to start with an empty database instead of the demo workspace.
AUTO_SEED=true
